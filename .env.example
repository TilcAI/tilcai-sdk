# Instancia de tilcai-infrastructure a la que habla el SDK (Tilcai.fromEnv()).
TILCAI_API_URL=
# Clave Bearer: de operador (TILCAI_API_KEYS) o de un tercero (npm run tenant -- key) con scopes payments, accounts:read, accounts:write.
TILCAI_API_KEY=
# testnet | mainnet
TILCAI_NETWORK=testnet
# Solo x402: URL y clave API del OpenZeppelin Relayer que corre el plugin facilitador.
TILCAI_RELAYER_URL=
TILCAI_RELAYER_API_KEY=
